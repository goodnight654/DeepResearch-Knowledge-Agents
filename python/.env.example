# LLM Configuration
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
QA_CONTEXT_LIMIT=8
DEEPRESEARCH_MAX_ITERATIONS=3
DEEPRESEARCH_QUERIES_PER_ITERATION=3
DEEPRESEARCH_CONTEXTS_PER_QUERY=4
DEEPRESEARCH_FINAL_CONTEXT_LIMIT=12
DEEPSEARCH_MAX_ITERATIONS=3
DEEPSEARCH_QUERIES_PER_ITERATION=3
DEEPSEARCH_CONTEXTS_PER_QUERY=4
DEEPSEARCH_FINAL_CONTEXT_LIMIT=12
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=
SERPAPI_API_KEY=
WEB_SEARCH_TIMEOUT_SECONDS=10
WEB_SEARCH_TOP_K=5
WEB_PAGE_FETCH_ENABLED=true
WEB_PAGE_TIMEOUT_SECONDS=10
WEB_PAGE_MAX_CHARS=12000
WEB_PAGE_CHUNKS_PER_RESULT=2
RUN_TRACE_DIR=./run_traces

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Vector Store: chroma | pgvector
VECTOR_STORE_TYPE=chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000

# PGVector (if VECTOR_STORE_TYPE=pgvector)
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/knowledge

# Kafka (CDC)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# API
API_HOST=0.0.0.0
API_PORT=8080
